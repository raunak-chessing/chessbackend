# --- Core (required) ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/chessdb?schema=public
NODE_ENV=development
PORT=4001

# --- Read replica (optional) ---
# Leave unset to serve read-heavy queries (leaderboards, tournament standings)
# from the primary database, same as today. Point this at a Postgres read
# replica once one exists to offload that traffic. Never used for anything
# touching live game state.
DATABASE_REPLICA_URL=

# --- Postgres connection pool (optional, sane defaults shown) ---
DB_POOL_MAX=20
DB_POOL_IDLE_TIMEOUT_MS=30000
DB_POOL_CONNECTION_TIMEOUT_MS=5000
DB_STATEMENT_TIMEOUT_MS=15000

# --- Redis (optional, defaults to a local instance) ---
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
QUEUE_REDIS_DB=1

# --- Frontend / auth ---
FRONTEND_URL=http://localhost:3000
ADMIN_EMAILS=admin@chessing.local
BETTER_AUTH_URL=http://localhost:4001
BETTER_AUTH_SECRET=change-me-to-a-long-random-string

# --- Social login (optional — omit to disable that provider) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- Error tracking (optional) ---
SENTRY_DSN=

# --- Stripe (required in production; optional in dev, a dummy key is used) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PREMIUM_PRICE_ID=

# --- Outgoing email (optional — defaults to Ethereal's test SMTP relay) ---
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Chess Arena <noreply@chessarena.com>"

# --- AI game-review narration (optional — feature no-ops without it) ---
GEMINI_API_KEY=
